# Public site URL used for canonical and social metadata. Production defaults
# to https://www.vetrux.tech when this variable is omitted.
NEXT_PUBLIC_SITE_URL=https://www.vetrux.tech

# Cloudflare Turnstile (required for all public inquiry forms).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP delivery (required for inquiry, quote, and document-request endpoints).
INQUIRY_MAIL_PROVIDER=aliyun
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
INQUIRY_MAIL_FROM=
INQUIRY_MAIL_TO=

# Comma-separated extra request origins. localhost:3000 and the production
# domains are already allowed by the API routes.
INQUIRY_ALLOWED_ORIGINS=
